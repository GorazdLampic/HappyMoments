{
  "name": "happymoments",
  "version": "1.0.0",
  "description": "Celebrate life's special numbers - track birthdays, anniversaries, and find amazing numerical milestones",
  "main": "build.js",
  "scripts": {
    "serve": "python serve.py",
    "build": "node build.js",
    "native-contract": "node tools/native-contract.js",
    "smoke": "node tools/prod-api-smoke.js",
    "release-check": "node build.js && node tools/native-contract.js && node tools/test-niceness.js && node tools/validate-build110.js && node tools/test-sw-update.js && node tools/screenshot-tour.js",
    "build:icons": "node scripts/generate-icons.js",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "cap:run": "npx cap run android",
    "android": "npm run build && npx cap sync && npx cap open android"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GorazdLampic/HappyMoments.git"
  },
  "keywords": [
    "milestones",
    "birthdays",
    "anniversaries",
    "numbers",
    "celebrations"
  ],
  "author": "Quantum Wave Ltd (Kvantni Val d.o.o.)",
  "license": "UNLICENSED",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/GorazdLampic/HappyMoments/issues"
  },
  "homepage": "https://github.com/GorazdLampic/HappyMoments#readme",
  "devDependencies": {
    "clean-css": "^5.3.3",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "terser": "^5.48.0"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "cordova-plugin-purchase": "13.18.0"
  }
}
